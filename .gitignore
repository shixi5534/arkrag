# ---- 不入库：只读原始语料与体积巨大的生成数据（计划 A2）----
# 语料投影 239 MB，只读输入。溯源锚点记在 data/arkrag/l0_manifest.json 与
# data/arkrag/corpus_meta.json（这两个小文件入库，否则无法证明跑的是哪份语料）。
corpus/
zh_CN.zip

# 抽取缓存：13,801 个文件。可从语料 + 提示词 + 契约重算，不该占仓库空间。
data/arkrag/cache/
data/arkrag/cache_quarantine/
# 索引：单文件 127 MB。
data/arkrag/index/

# 大图与大流水线中间产物（单个 16–71 MB）。入库的是它们的 Manifest 与门禁报告。
data/arkrag/graph.json
data/arkrag/chunks.jsonl
data/arkrag/scenes.jsonl
data/arkrag/agent_inbox/
data/arkrag/agent_outbox/

# Generation 里的图与索引是同一批大产物，只是换了目录。
data/arkrag/generations/*/graph/
data/arkrag/generations/*/index/

# 世代自带的块正文（T1 子集 JSONL，每代约 40 MB）。它必须跟着世代走——引用
# 偏移是在这一代自己的块正文上算出来的，消费者从别处拿块正文会让
# `text[start:end] == evidence` 静默对不上（见 src/arkrag/pipeline.py 的
# resolve_chunks 与 docs/k阶段实测.md）。体积与原 data/arkrag/chunks.jsonl 同级，
# 同样不入库；可由 L2 产物 + 该代 Manifest 的 chunk_manifest_hash 重算。
data/arkrag/generations/*/chunks.jsonl

# FTS5 检索库：单个 212 MB，可由 generations/*/index/lexical.json 重算
# （scripts/build_fts_index.py，36 秒）。与 data/arkrag/index/ 同理不入库。
# 注意：它刻意放在世代目录之外（见 docs/h3-FTS5迁移.md §2.4），
# 因此不受上面两条 generations 规则覆盖，需要单独一行。
data/arkrag/fts/

# 向量矩阵：bge-m3 1024 维 × 13,781 块 = 56.4 MB，可由 scripts/build_vectors.py
# 重算（约 610 秒，依赖本机 Ollama 的 bge-m3 模型）。命名用「模型 slug + 索引内容
# 摘要」而非世代 id，所以内容相同的多个世代共用同一份（见 src/arkrag/vector_store.py
# 的 vector_paths 注释）。与上面同理不入库。
data/arkrag/vectors/

# 运行日志：机器相关、每次不同，由 runs/<run_id>/ 现场生成。
data/arkrag/runs/*/events.jsonl

# 服务端运行期产物：查询日志与审计流水。都是"跑了就有、内容每次不同"的
# 现场记录，不是可复现的结论。queries.jsonl 默认只写 `query_sha256`
# 不写问句原文（见 src/arkrag/server.py 的 `_log_query_record`），
# 但即便如此它仍是运行痕迹而非证据，不入库。
data/arkrag/logs/
data/arkrag/audit/

# 锁文件是运行期同步副产物，永远不该入库。
*.lock
data/arkrag/*.lock
data/arkrag/**/*.lock

# ---- 工具与本地环境 ----
__pycache__/
*.py[cod]
.venv/
.env
.pytest_cache/
.ruff_cache/

# conda 环境目录（`conda env create -p ./.conda` 时会产生；具名环境不落在仓库里）。
# 规格文件 environment.yml 必须入库，环境本身不入库。
.conda/
env/

# uv 的本地缓存（本机 `%LOCALAPPDATA%\uv\cache` 被沙箱拒绝，
# 安装依赖时用 `UV_CACHE_DIR=E:\图rag\_uvcache` 重定向到这里）。
_uvcache/

# pytest 的 `--basetemp` 目录。本机沙箱拒绝写系统临时目录，
# 只能指到项目内；它是运行副产物，不入库。
_pytest_tmp/

data/arkrag/staging/

# 一次性临时文件（提交说明、诊断输出）。这些不该入库：
# 提交说明 `_commit_msg.txt` 已经被误入库两次（a5031b9 与 ea3c52d），
# 每次都靠后续 commit 删掉——与其靠记性，不如让 git 看不见它们。
_commit_msg*.txt
_*.tmp
_*.log

# I2 盲特征重排的逐题特征缓存（2.45 MB，可由 scripts/rerank_blind.py 重算约 5 分钟）。
# 同目录下的小体积扫描结果（sweep_*.json / eval_fusion_*.json / rerank_blind.json）
# 是结论的证据，应当入库。
data/rerank_features.json

# ---- 一次性诊断脚本与中间量（2026-11-08 纳管）--------------------------------
# 背景：仓库根目录累积了 620 个 `tmp_*`（七轮对抗审查 + 一轮全链路诊断的脚本、
# 落盘、日志，合计 11.7 MB），`data/_tmp_*` 80 个中间量，`scripts/tmp_*` 14 个探针。
# 这些文件被 docs 引用（根目录脚本 98 处、data/_tmp_ 33 处），但按本项目既有纪律
# 「临时，不入库」（docs/a_P3_第三轮_方案.md、docs/诊断-知识交接-20261108.md §1.3
# 均如此声明）——需要复算时按 docs 里给的命令重跑即可，不必靠仓库快照。
#
# 刻意不写 `tmp_*` 这种无斜杠模式：那会连 `data/tmp_*`、`docs/tmp_*` 一起吞掉，
# 而 `docs/_tmp_budget_wire_report.md` 是 `tests/test_context_budget.py` 直接引用的
# 证据文档，必须入库（下划线开头，不受下面三条影响）。
/tmp_*
/data/_tmp_*
/scripts/tmp_*

# 366 MB 的 onnxruntime 第三方解包目录（`scripts/probe_rerank_opt.py` 与 GPU 基准用），
# 纯上游二进制，绝不入库。
/data/_tmp_ortgpu/

# 一次性的表格打印小抄（读 `data/_tmp_rerank_opt.json`，该文件本身已在上面被忽略）。
/_tab.py
